// mistpine for Waybar: the bar in the screenshots.
// https://github.com/mistpine/mistpine.waybar · MIT License
// Generated by scripts/generate.ts from src/config.jsonc and the mistpine
// spec. Do not edit by hand.
{
  "layer": "top",
  "position": "top",

  "modules-left": ["cpu", "memory", "disk"],
  "modules-center": ["sway/workspaces", "sway/mode"],
  "modules-right": ["network", "pulseaudio", "clock", "tray"],

  // Labels in yellow, values in bright purple (purple is 4.49:1 on bg2).
  "cpu": {
    "interval": 2,
    "format": "<span color='#c2a55b'><b>CPU</b></span> <span color='#b8a8c6'>{usage}%</span>"
  },
  "memory": {
    "interval": 5,
    "format": "<span color='#c2a55b'><b>RAM</b></span> <span color='#b8a8c6'>{used:0.1f} GiB ({percentage}%)</span>"
  },
  "disk": {
    "path": "/",
    "interval": 30,
    "format": "<span color='#c2a55b'><b>{path}</b></span> <span color='#b8a8c6'>{percentage_used}%</span>"
  },
  "network": {
    "interval": 5,
    "format": "<span color='#c2a55b'><b>{ifname}</b></span> <span color='#b8a8c6'>{ipaddr}</span>",
    "format-disconnected": "<b>offline</b>",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "<span color='#c2a55b'><b>VOL</b></span> <span color='#b8a8c6'>{volume}%</span>",
    "format-muted": "<b>VOL</b> muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "clock": {
    "interval": 30,
    "format": "<span color='#b8a8c6'>{:%a %d %b  %H:%M}</span>",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": {
    "spacing": 8
  }
}
