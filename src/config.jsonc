// The bar in the screenshots. scripts/generate.ts writes it to
// examples/config.jsonc with the palette names in span colors replaced by
// the spec's hex (Waybar's markup cannot read CSS colors).
{
  "layer": "top",
  "position": "top",

  "modules-left": ["cpu", "memory", "disk"],
  "modules-center": ["sway/workspaces", "sway/mode"],
  "modules-right": ["network", "pulseaudio", "clock", "tray"],

  // Labels in yellow, values in bright purple (purple is 4.49:1 on bg2).
  "cpu": {
    "interval": 2,
    "format": "<span color='@yellow'><b>CPU</b></span> <span color='@bright-purple'>{usage}%</span>"
  },
  "memory": {
    "interval": 5,
    "format": "<span color='@yellow'><b>RAM</b></span> <span color='@bright-purple'>{used:0.1f} GiB ({percentage}%)</span>"
  },
  "disk": {
    "path": "/",
    "interval": 30,
    "format": "<span color='@yellow'><b>{path}</b></span> <span color='@bright-purple'>{percentage_used}%</span>"
  },
  "network": {
    "interval": 5,
    "format": "<span color='@yellow'><b>{ifname}</b></span> <span color='@bright-purple'>{ipaddr}</span>",
    "format-disconnected": "<b>offline</b>",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "<span color='@yellow'><b>VOL</b></span> <span color='@bright-purple'>{volume}%</span>",
    "format-muted": "<b>VOL</b> muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "clock": {
    "interval": 30,
    "format": "<span color='@bright-purple'>{:%a %d %b  %H:%M}</span>",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": {
    "spacing": 8
  }
}
